<%
  header_tags_content = content_for(:header_tags)

   if header_tags_content.present? && header_tags_content.include?('/jstoolbar/')
     unless header_tags_content.include?('redmine_jstoolbar_ext.js')
       content_for :header_tags do
         javascript_include_tag('redmine_jstoolbar_ext.js', plugin: 'redmine_jstoolbar_ext') + "\n" +
         stylesheet_link_tag('redmine_jstoolbar_ext.css', plugin: 'redmine_jstoolbar_ext') + "\n"
       end
     end

     content_for :header_tags do
        # Expose the Rails relative URL root (e.g. "/redmine" or "") so the
        # plugin JS can build correct attachment URLs. On Redmine 6 / propshaft
        # the old stylesheet-href stripping trick no longer works.
        javascript_tag("var jstoolbarExtImagesUrlRoot = #{Redmine::Utils.relative_url_root.to_s.to_json};") + "\n" +
        javascript_include_tag('redmine_jstoolbar_ext_images.js', plugin: 'redmine_jstoolbar_ext_images') + "\n"  +
          stylesheet_link_tag('redmine_jstoolbar_ext_images.css', plugin: 'redmine_jstoolbar_ext_images') + "\n"
     end
   end
-%>